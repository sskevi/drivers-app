{
  "info": {
    "name": "Drivers App API",
    "description": "Complete API collection for the Drivers App marketplace",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Learner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Learner\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"learner\",\n  \"phone\": \"+1234567890\"\n}"
            }
          }
        },
        {
          "name": "Register Instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Instructor\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"instructor\",\n  \"phone\": \"+0987654321\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"phone\": \"+1111111111\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Instructors",
      "item": [
        {
          "name": "Create Instructor Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/instructors/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Experienced driving instructor with 10+ years of teaching\",\n  \"experience\": 10,\n  \"credentials\": [\n    {\n      \"title\": \"Certified Driving Instructor\",\n      \"issuedBy\": \"State DMV\",\n      \"dateIssued\": \"2014-05-15\"\n    }\n  ],\n  \"vehicleType\": [\"Manual\", \"Automatic\"],\n  \"languages\": [\"English\", \"Spanish\"],\n  \"serviceArea\": {\n    \"city\": \"Los Angeles\",\n    \"state\": \"CA\",\n    \"radius\": 30\n  },\n  \"pricing\": {\n    \"hourlyRate\": 60,\n    \"packageDeals\": [\n      {\n        \"name\": \"10-Hour Package\",\n        \"hours\": 10,\n        \"price\": 550,\n        \"description\": \"Save $50 with this package\"\n      }\n    ]\n  },\n  \"availability\": [\n    {\n      \"dayOfWeek\": 1,\n      \"startTime\": \"08:00\",\n      \"endTime\": \"18:00\"\n    },\n    {\n      \"dayOfWeek\": 3,\n      \"startTime\": \"08:00\",\n      \"endTime\": \"18:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get All Instructors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instructors"
          }
        },
        {
          "name": "Search Instructors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instructors/search?city=Los Angeles&vehicleType=Manual&minRating=4"
          }
        },
        {
          "name": "Get Own Instructor Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/instructors/profile"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instructorId\": \"instructor_user_id\",\n  \"date\": \"2024-03-25T00:00:00.000Z\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"duration\": 2,\n  \"notes\": \"First time learning to drive\",\n  \"pickupLocation\": {\n    \"address\": \"123 Main Street, Los Angeles, CA\"\n  }\n}"
            }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/:id"
          }
        },
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/:id/payment"
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/:id/confirm-payment"
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings/:id/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/:id"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"booking_id\",\n  \"rating\": 5,\n  \"comment\": \"Excellent instructor! Very patient and knowledgeable.\"\n}"
            }
          }
        },
        {
          "name": "Get Instructor Reviews",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reviews/instructor/:instructorId"
          }
        },
        {
          "name": "Get Review by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reviews/:id"
          }
        },
        {
          "name": "Add Review Response",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reviews/:id/response",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Thank you for your kind words!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Create or Get Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/messages/conversation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantId\": \"other_user_id\"\n}"
            }
          }
        },
        {
          "name": "Get All Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/messages/conversations"
          }
        },
        {
          "name": "Get Messages in Conversation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/messages/conversation/:conversationId"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"conversation_id\",\n  \"content\": \"Hi, I would like to schedule a lesson.\"\n}"
            }
          }
        },
        {
          "name": "Mark Message as Read",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/messages/:id/read"
          }
        }
      ]
    }
  ]
}
